{
  "expo": {
    "name": "40 Kun",
    "slug": "habits-tracker-app",
    "owner": "azamat_azadov",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "qirqkun",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e807c313-970d-48c7-bf67-656e6379b732"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.qirqkun.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.qirqkun.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#7C4DFF",
          "defaultChannel": "habit-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e807c313-970d-48c7-bf67-656e6379b732"
      }
    }
  }
}
