{
  "expo": {
    "name": "40 Kun",
    "slug": "habits-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "qirqkun",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.qirqkun.app",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "uz.qirqkun.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7C4DFF",
          "defaultChannel": "habit-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
